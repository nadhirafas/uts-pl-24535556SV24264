{
	frankenphp
	auto_https off

	# Aktifkan metrik per-permintaan (caddy_http_requests_total, caddy_http_request_duration_seconds)
	servers {
		metrics
	}
}

:80 {
	root * /app/public
	encode zstd gzip

	# Access log ke stdout -> terlihat di `docker compose logs backend` (bukti FrankenPHP)
	log {
		output stdout
		format console
	}

	php_server
}

# Endpoint metrik KHUSUS Prometheus. Port 9180 tidak dipublikasikan ke host
# (tidak ada di "ports:" compose), hanya terjangkau dari jaringan compose.
:9180 {
	metrics /metrics
}
