# Salin menjadi .env (JANGAN di-commit), lalu isi nilainya.
# APP_KEY: jalankan `php artisan key:generate --show` di folder backend/
APP_KEY=base64:GANTI_DENGAN_HASIL_KEY_GENERATE
DB_DATABASE=uts_books
DB_USERNAME=uts_user
DB_PASSWORD=ganti_dengan_password_kuat
DB_ROOT_PASSWORD=ganti_dengan_root_password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti_dengan_password_admin
