        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"IPS Kelas 8\",\n  \"author\": \"Ra\",\n  \"year\": 2024\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
