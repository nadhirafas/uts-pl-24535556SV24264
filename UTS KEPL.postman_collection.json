                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\r\n\r\nif (response.token) {\r\n    pm.collectionVariables.set(\"token\", response.token);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
